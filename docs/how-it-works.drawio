<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="How a read works">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="eth" value="Ethereum" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="460" height="460" as="geometry" />
        </mxCell>
        <mxCell id="keeper" value="&lt;b&gt;1. Keeper&lt;/b&gt; (anyone)&lt;br&gt;snapshot([queries])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="eth">
          <mxGeometry x="20" y="60" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="snap" value="&lt;b&gt;2. NoriSnapshot&lt;/b&gt;&lt;br&gt;runs the views, stores one&lt;br&gt;results root (write-once)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="eth">
          <mxGeometry x="20" y="190" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="targets" value="&lt;b&gt;Any contract&lt;/b&gt;&lt;br&gt;balanceOf, paused(), ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="eth">
          <mxGeometry x="270" y="190" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="&lt;b&gt;3. Proof request queue&lt;/b&gt;&lt;br&gt;one request per snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="eth">
          <mxGeometry x="20" y="340" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="prv" value="Nori prover (off-chain)" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="260" height="460" as="geometry" />
        </mxCell>
        <mxCell id="prover" value="&lt;b&gt;4. bridge-head&lt;/b&gt;&lt;br&gt;Helios light client in SP1&lt;br&gt;proves finalized state&lt;br&gt;+ the queue batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="prv">
          <mxGeometry x="20" y="170" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="sol" value="Solana" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="880" y="40" width="300" height="460" as="geometry" />
        </mxCell>
        <mxCell id="update" value="&lt;b&gt;5. Nori program: update&lt;/b&gt;&lt;br&gt;verifies the ZK proof" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="sol">
          <mxGeometry x="40" y="60" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="batch" value="&lt;b&gt;Batch account&lt;/b&gt;&lt;br&gt;batch root" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="sol">
          <mxGeometry x="40" y="190" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="consumer" value="&lt;b&gt;7. Your program (Backstop)&lt;/b&gt;&lt;br&gt;nori-read checks 2 Merkle paths&lt;br&gt;~3,400 compute units" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="sol">
          <mxGeometry x="40" y="330" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e4label" value="waits ~13 min for finality" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="280" y="425" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="builder" value="&lt;b&gt;6. Witness builder&lt;/b&gt; (TS)&lt;br&gt;Snapshot event + queue&lt;br&gt;= witness transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="580" y="560" width="220" height="70" as="geometry" />
        </mxCell>

