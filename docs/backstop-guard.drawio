<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Backstop guard">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="keeper" value="&lt;b&gt;checkpoint()&lt;/b&gt; (anyone)&lt;br&gt;records Solana supply each interval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="relayer" value="&lt;b&gt;submit_read()&lt;/b&gt; (anyone)&lt;br&gt;proven backing or pause flag&lt;br&gt;checked by nori-read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="guard" value="&lt;b&gt;Guard&lt;/b&gt; (one per asset)&lt;br&gt;last 64 supply checkpoints&lt;br&gt;proven backing + pause flag&lt;br&gt;newest Ethereum block only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rule" value="&lt;b&gt;Trip rule&lt;/b&gt; for backing at Ethereum time T:&lt;br&gt;lowest supply in [T-10m, T-1m]&lt;br&gt;&amp;gt; backing + tolerance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="640" y="60" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tripped" value="&lt;b&gt;TRIPPED&lt;/b&gt; (latched)&lt;br&gt;a refill does not clear it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;unlatch()&lt;/b&gt; (guard admin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="640" y="320" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="status" value="&lt;b&gt;status() / assert_healthy()&lt;/b&gt;&lt;br&gt;TRIPPED, PAUSED_AT_SOURCE,&lt;br&gt;STALE (no fresh backing),&lt;br&gt;WARN (live supply &amp;gt; backing), HEALTHY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lender" value="&lt;b&gt;Lending market&lt;/b&gt;&lt;br&gt;CPI assert_healthy() on deposit;&lt;br&gt;repay and liquidate never blocked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="340" y="460" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2727;entryDx=0;entryDy=0;" edge="1" parent="1" source="keeper" target="guard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7273;entryDx=0;entryDy=0;" edge="1" parent="1" source="relayer" target="guard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=1;exitY=0.2727;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="guard" target="rule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="rule" target="tripped">
          <mxGeometry relative="1" as="geometry" />
