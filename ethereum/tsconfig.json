{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["es2022"],
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["mocha", "node"],
        "rootDir": "."
    },
    "exclude": ["node_modules", "build", "artifacts", "cache"],
    "files": ["./hardhat-env.d.ts"],
    "include": [
        "*.ts",
        "tasks/**/*.ts",
        "test/**/*.ts",
        "test/**/*.json",
        "types/**/*.ts",
        "vectors/**/*.ts",
        "scripts/**/*.ts"
    ]
}
