# Ethereum =================================================================
# Deployer private key (bare hex, no 0x prefix)
ETH_PRIVATE_KEY=
# Execution JSON-RPC endpoint
ETH_RPC_URL=
# Network label: hardhat, sepolia, mainnet, hoodi
ETH_NETWORK=sepolia

# Fork tests (npm run test:fork) ============================================
# Mainnet JSON-RPC to fork; defaults to https://ethereum-rpc.publicnode.com
ETH_MAINNET_FORK_RPC_URL=

# Deploy ====================================================================
# Existing NoriProofRequestQueue to enqueue on. Leave unset to deploy a
# dedicated queue for snapshots alongside NoriSnapshot.
NORI_ETH_PROOF_QUEUE_ADDRESS=
# Operator of a newly deployed queue (Safe or Timelock); defaults to deployer
NORI_ETH_SNAPSHOT_QUEUE_OPERATOR_ADDRESS=
# Treasury of a newly deployed queue; unset defers it to setFeeRecipient
NORI_ETH_SNAPSHOT_QUEUE_FEE_RECIPIENT_ADDRESS=
# Per-request fee of a newly deployed queue in wei, a multiple of 10^12
NORI_ETH_SNAPSHOT_PROOF_REQUEST_QUEUE_FEE_WEI=0
