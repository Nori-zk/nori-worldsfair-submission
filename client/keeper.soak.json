{
    "ethereum": {
        "rpcUrl": "${ETH_RPC_URL}",
        "chainId": "${ETH_CHAIN_ID}",
        "noriSnapshot": "${NORI_ETH_SNAPSHOT_ADDRESS}",
        "proofQueue": "${NORI_ETH_PROOF_QUEUE_ADDRESS}"
    },
    "solana": {
        "rpcUrl": "${SOLANA_RPC_NETWORK_URL}",
        "genesisHash": "${SOLANA_GENESIS_HASH}",
        "keypair": "${SOLANA_PAYER_KEYPAIR_PATH}",
        "noriProgram": "${NORI_SOL_TOKEN_PROGRAM_ID}"
    },
    "intervals": {
        "snapshotSecs": 900,
        "checkpointSecs": 120,
        "pollSecs": 30
    },
    "stateFile": "keeper-soak-state.json",
    "guards": [
        {
            "name": "demo-lockbox",
            "mint": "${BACKSTOP_DEMO_MINT}",
            "backing": {
                "target": "${NORI_ETH_DEMO_LOCKBOX_ADDRESS}",
                "signature": "locked()",
                "args": []
            },
            "pause": {
                "target": "${NORI_ETH_DEMO_LOCKBOX_ADDRESS}",
                "signature": "paused()",
                "args": []
            },
            "backingDecimals": 18,
            "tolerance": "1000000000",
            "windowSecs": 600,
            "skewSecs": 60,
            "checkpointIntervalSecs": 120,
            "maxStalenessSecs": 7200
        },
        {
            "name": "shadow-lockbox",
            "mint": "${BACKSTOP_SHADOW_MINT}",
            "backing": {
                "target": "${NORI_ETH_SHADOW_LOCKBOX_ADDRESS}",
                "signature": "locked()",
                "args": []
            },
            "pause": {
                "target": "${NORI_ETH_SHADOW_LOCKBOX_ADDRESS}",
                "signature": "paused()",
                "args": []
            },
            "backingDecimals": 18,
            "tolerance": "1000000000",
            "windowSecs": 600,
            "skewSecs": 60,
            "checkpointIntervalSecs": 120,
            "maxStalenessSecs": 7200
        }
    ]
}
