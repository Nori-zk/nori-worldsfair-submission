{
    "name": "@nori-zk/solana-web-ui",
    "version": "0.0.1",
    "private": true,
    "description": "Shared yaw components and services for the Nori Solana apps and dashboards",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "prepare": "ts-patch install",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --check src/",
        "format:fix": "prettier --write src/",
        "tokens:fetch": "node scripts/fetch-token-list.mjs"
    },
    "dependencies": {
        "@nori-zk/nori-bridge-solana-sdk": "0.1.0",
        "@yaw-rx/core": "^0.1.3",
        "@yaw-rx/ystate": "^0.1.0",
        "motion": "^14.0.0",
        "rxjs": "8.0.0-alpha.14",
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@types/three": "^0.186.0",
        "@yaw-rx/transformer": "^0.1.2",
        "@yaw-rx/ts-plugin": "^0.1.2",
        "ts-patch": "^3.3.0"
    }
}
