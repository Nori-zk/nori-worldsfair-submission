{
    "name": "@nori-zk/solana-guard-status-app",
    "version": "0.0.1",
    "private": true,
    "description": "Each Backstop guard's proven Ethereum backing against its Solana supply",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "prepare": "ts-patch install",
        "dev": "vite",
        "clean": "rimraf dist",
        "build": "npm run clean && vite build",
        "build:ssg": "yaw-ssg dist public",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "node --import ../../test/resolve-ts.mjs --test 'src/**/*.test.ts'",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --check src/",
        "format:fix": "prettier --write src/"
    },
    "dependencies": {
        "@nori-zk/backstop-client": "*",
        "@nori-zk/nori-bridge-solana-sdk": "0.3.0",
        "@nori-zk/solana-web-ui": "*",
        "@solana/kit": "^8.3.0",
        "@yaw-rx/core": "^0.1.3",
        "rxjs": "8.0.0-alpha.14"
    },
    "devDependencies": {
        "@yaw-rx/ssg": "^0.1.2",
        "@yaw-rx/transformer": "^0.1.2",
        "@yaw-rx/ts-plugin": "^0.1.2",
        "@yaw-rx/vite": "^0.1.3",
        "dotenv": "^17.2.4",
        "ts-patch": "^3.3.0",
        "vite": "^5.0.0"
    }
}
