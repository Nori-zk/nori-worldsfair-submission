# Built into every app and dashboard under web/ (web/env.ts). Public values
# only: everything here reaches the browser. The shell environment wins.

# Ethereum (Sepolia) ============================================================
NORI_WEB_ETH_CHAIN_ID=11155111
# A public Ethereum RPC for reads, so they work without a wallet. It must keep
# logs back to the queue's deploy block (publicnode prunes them).
NORI_WEB_ETH_RPC_URL=https://sepolia.gateway.tenderly.co
NORI_ETH_PROOF_QUEUE_ADDRESS=0x9AeAc0174f7bDf397C6dB1f62c120E8170e5B87e
# The first block to read proof requests from: the queue's deploy block
NORI_WEB_PROOF_QUEUE_DEPLOY_BLOCK=11856173
NORI_ETH_SNAPSHOT_ADDRESS=0xC377EbBF516a9DB2Fe5AEB65fA19D4dca1717340

# Solana (devnet) ===============================================================
# mainnet, devnet or testnet
NORI_WEB_SOLANA_CLUSTER=devnet
# Optional: a dedicated RPC for that cluster (its websocket is the same URL over
# wss). Empty uses the cluster's public endpoint. Set a keyed URL in the host's
# build environment, not here: this file is committed.
NORI_WEB_SOLANA_RPC_URL=
NORI_SOL_TOKEN_PROGRAM_ID=EUz5RMQxYkc9zu12wpCDu9syvr4MarghoYb6jHAvdAcg
# Any existing system account holding SOL: Prove balance names it as the fee
# payer of the simulation that verifies a result; it signs and pays nothing.
NORI_WEB_SOLANA_FEE_PAYER=EuRkxPWMLFrNqzNFZYsC7JQZhNewxLfLz3aQFVzts27Y

# Bridge ========================================================================
NORI_WEB_BRIDGE_WSS_URL=wss://wss.solana.nori.it.com

# Apps ==========================================================================
# Each app's and dashboard's address, for the links along the top of every page:
# the dev servers by default. Once hosted, set the hosted ones in the host's
# build environment.
NORI_WEB_PROVE_BALANCE_URL=http://localhost:5180
NORI_WEB_GUARD_STATUS_URL=http://localhost:5181
NORI_WEB_PROVEN_FACTS_URL=http://localhost:5182
NORI_WEB_DASHBOARD_URL=http://localhost:7400
# Optional: the Tempo submission's bridge dashboard. Empty leaves its link out.
NORI_WEB_TEMPO_DASHBOARD_URL=
