# One .env for the whole repo: cp .env.example .env (gitignored).
# Read by the ethereum scripts and the keeper. The shell environment wins over it.
# Deploys write their addresses to ethereum/.env.nori-eth-snapshot,
# ethereum/.env.nori-eth-demo and .env.nori-sol-demo; the keeper reads those too.

# Ethereum ===================================================================
# sepolia, mainnet, hoodi, ... (the Hardhat network name)
ETH_NETWORK=sepolia
ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Deployer, and the keeper's snapshot signer (hex)
ETH_PRIVATE_KEY=

# The proof queue bridge-head proves; NoriSnapshot enqueues on it.
# Unset: `npm run deploy -w ethereum` deploys a dedicated queue too.
NORI_ETH_PROOF_QUEUE_ADDRESS=0x9AeAc0174f7bDf397C6dB1f62c120E8170e5B87e
# Only for a newly deployed queue: operator (defaults to the deployer),
# fee recipient, and per-request fee in wei (a multiple of 10^12)
NORI_ETH_SNAPSHOT_QUEUE_OPERATOR_ADDRESS=
NORI_ETH_SNAPSHOT_QUEUE_FEE_RECIPIENT_ADDRESS=
NORI_ETH_SNAPSHOT_PROOF_REQUEST_QUEUE_FEE_WEI=0

# npm run test:fork -w ethereum (default: https://ethereum-rpc.publicnode.com)
ETH_MAINNET_FORK_RPC_URL=
# Optional: fork at this block, for reproducible gas (needs an archive RPC)
ETH_MAINNET_FORK_BLOCK=

# Solana (same names as nori-solana-sdk) ======================================
SOLANA_RPC_NETWORK_URL=https://api.devnet.solana.com
# Payer, guard admin and Backstop upgrade authority
SOLANA_PAYER_KEYPAIR_PATH=~/.config/solana/id.json
# The Nori token program bridge-head updates
NORI_SOL_TOKEN_PROGRAM_ID=EUz5RMQxYkc9zu12wpCDu9syvr4MarghoYb6jHAvdAcg

# Backstop demo ================================================================
# The mint the demo guard watches. scripts/deploy-devnet.sh creates it and
# writes it to .env.nori-sol-demo; set it here only to use another mint.
BACKSTOP_DEMO_MINT=
