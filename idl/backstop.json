            "discriminator": [210, 164, 95, 81, 158, 19, 225, 32],
            "accounts": [
                {
                    "name": "admin",
                    "signer": true,
                    "relations": ["guard"]
                },
                {
                    "name": "guard",
                    "writable": true
                }
            ],
            "args": []
        }
    ],
