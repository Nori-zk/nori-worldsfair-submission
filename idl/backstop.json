    "metadata": {
        "name": "backstop",
        "version": "0.1.0",
        "spec": "0.1.0",
        "description": "Circuit breakers for bridged assets: proven Ethereum backing vs Solana supply"
    },
    "instructions": [
        {
            "name": "assert_healthy",
            "docs": [
                "Fails unless the guard is HEALTHY. Read-only, so consumers CPI it on",
                "every deposit without write-locking the guard."
            ],
            "discriminator": [237, 28, 73, 110, 58, 17, 139, 47],
            "accounts": [
                {
                    "name": "guard"
                },
                {
                    "name": "mint",
                    "relations": ["guard"]
                }
            ],
            "args": []
        },
        {
            "name": "checkpoint",
            "docs": [
                "Records the mint's supply, at most once per `checkpoint_interval_secs`."
            ],
            "discriminator": [213, 200, 19, 204, 240, 143, 184, 252],
            "accounts": [
                {
                    "name": "guard",
                    "writable": true
                },
                {
                    "name": "mint",
                    "relations": ["guard"]
                }
            ],
            "args": []
        },
        {
            "name": "create_guard",
            "docs": [
                "Creates a guard for `mint`, owned by `admin`. Reads the Ethereum queue",
                "the Nori program proves, so anyone can check it is NoriSnapshot's."
            ],
            "discriminator": [251, 254, 17, 198, 219, 218, 154, 99],
            "accounts": [
                {
                    "name": "admin",
                    "writable": true,
                    "signer": true
                },
                {
                    "name": "mint"
                },
                {
                    "name": "nori_state",
                    "docs": ["`nori_read::load_nori_proof_queue`."]
                },
                {
                    "name": "guard",
                    "writable": true,
                    "pda": {
                        "seeds": [
                            {
                                "kind": "const",
                                "value": [103, 117, 97, 114, 100]
                            },
                            {
                                "kind": "account",
                                "path": "mint"
                            },
                            {
                                "kind": "account",
                                "path": "admin"
                            }
                        ]
                    }
                },
                {
                    "name": "system_program",
                    "address": "11111111111111111111111111111111"
                }
            ],
            "args": [
                {
                    "name": "config",
                    "type": {
                        "defined": {
                            "name": "GuardConfig"
                        }
                    }
                }
            ]
        },
        {
            "name": "status",
            "docs": ["The guard's status (also in return data)."],
            "discriminator": [218, 160, 35, 24, 130, 107, 205, 125],
            "accounts": [
                {
                    "name": "guard"
                },
                {
                    "name": "mint",
                    "relations": ["guard"]
                }
            ],
            "args": [],
            "returns": {
                "defined": {
                    "name": "Status"
                }
            }
        },
        {
            "name": "submit_read",
            "docs": [
                "Applies a proven NoriSnapshot result: the backing or the pause flag.",
                "Each must be from a newer Ethereum block than the last one applied."
            ],
            "discriminator": [60, 114, 38, 179, 10, 0, 92, 204],
            "accounts": [
                {
                    "name": "guard",
                    "writable": true
                },
                {
                    "name": "mint",
                    "relations": ["guard"]
                },
                {
                    "name": "proof_queue_batch",
                    "docs": ["`nori_read::load_proof_queue_batch`."]
                }
            ],
            "args": [
                {
                    "name": "kind",
                    "type": {
                        "defined": {
                            "name": "ReadKind"
                        }
                    }
                },
                {
                    "name": "witness",
                    "type": {
                        "defined": {
                            "name": "SnapshotResultWitness"
                        }
                    }
                }
            ]
        },
        {
            "name": "unlatch",
            "docs": [
                "Clears a trip. Admin only; for testing and demos (production: a timelock or governance)."
